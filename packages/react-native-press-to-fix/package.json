{
  "name": "react-native-press-to-fix",
  "version": "0.1.1",
  "description": "Long press any element of your React Native app in the iOS simulator, say what is wrong, and Claude Code fixes it.",
  "license": "MIT",
  "main": "lib/commonjs/index.js",
  "react-native": "src/index.ts",
  "types": "lib/typescript/index.d.ts",
  "files": [
    "lib",
    "src",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "react-native",
    "expo",
    "claude-code",
    "devtools"
  ],
  "scripts": {
    "build": "rm -rf lib && tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json",
    "prepack": "npm run build && cp ../../README.md ../../LICENSE .",
    "postpack": "rm -f README.md LICENSE",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "testMatch": [
      "<rootDir>/tests/**/*.test.tsx"
    ]
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezescigo/react-native-press-to-fix.git",
    "directory": "packages/react-native-press-to-fix"
  },
  "homepage": "https://github.com/ezescigo/react-native-press-to-fix",
  "module": "lib/module/index.js",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.ts",
      "import": "./lib/module/index.js",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false
}
