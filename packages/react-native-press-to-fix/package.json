{
  "name": "react-native-press-to-fix",
  "version": "0.1.0",
  "description": "Long press any element of your React Native app in the iOS simulator, say what is wrong, and Claude Code fixes it.",
  "license": "MIT",
  "main": "src/index.ts",
  "react-native": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src"
  ],
  "keywords": [
    "react-native",
    "expo",
    "claude-code",
    "devtools"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.76"
  },
  "jest": {
    "preset": "jest-expo/ios",
    "testMatch": [
      "<rootDir>/tests/**/*.test.tsx"
    ]
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "test-renderer": "^1.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ezescigo/react-native-press-to-fix",
    "directory": "packages/react-native-press-to-fix"
  },
  "homepage": "https://github.com/ezescigo/react-native-press-to-fix"
}
